{
  "name": "flowglad-examples",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "nextjs/*",
    "react-vite/*",
    "tanstack-start/*"
  ],
  "scripts": {
    "lint": "turbo run lint",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "format": "bunx @biomejs/biome check --write .",
    "format:check": "bunx @biomejs/biome check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "husky": "^9.1.7",
    "turbo": "^2.4.4"
  }
}
